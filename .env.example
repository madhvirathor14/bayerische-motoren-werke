# ========================================
# BMW GRAPHRAG PROJECT - ENVIRONMENT SETUP
# ========================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to GitHub!

# ========================================
# GROQ API (Main LLM - FREE & FAST)
# ========================================
# Get free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ========================================
# GOOGLE GEMINI (Backup LLM - FREE)
# ========================================
# Get free key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ========================================
# PROJECT SETTINGS
# ========================================
PROJECT_NAME=Bayerische Motoren Werke
PROJECT_DESCRIPTION=GraphRAG-Powered Luxury Car Knowledge Engine
DEBUG_MODE=False

# ========================================
# MODEL SETTINGS
# ========================================
GROQ_MODEL=mixtral-8x7b-32768
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_TOKENS=1024
TEMPERATURE=0.7

# ========================================
# DATA PATHS
# ========================================
DATA_DIR=./data
RAW_DOCUMENTS_DIR=./data/raw_documents
IMAGES_DIR=./data/images
CACHE_DIR=./cache

# ========================================
# EVALUATION SETTINGS
# ========================================
LLM_JUDGE_MODEL=mixtral-8x7b-32768
BERTSCORE_MODEL=all-mpnet-base-v2
ACCURACY_THRESHOLD=0.7

# ========================================
# BENCHMARK SETTINGS
# ========================================
NUM_TEST_QUERIES=20
TIMEOUT_SECONDS=60
ENABLE_CACHING=True
